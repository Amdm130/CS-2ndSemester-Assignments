// Selection Sort
// Create a Java program that implements the Selection Sort algorithm.
// Your program should:
// 1. Create an integer array.
// 2. Display the original/unsorted array.
// 3. Sort the array using Selection Sort.
// 4. Display the sorted array.
// Example
// Input:
// 64 25 12 22 11
// Output:
// 11 12 22 25 64

// -------------------------------------

public class selectionSort {
    public static void main(String[] args) {
        int[] arr = {64, 25, 12, 22, 11};

        //for Displaying the original array
        System.out.print("Original array: ");
        for (int num : arr) {
            System.out.print(num + " ");
        }

        //Selection Sort
        for (int i = 0; i < arr.length - 1; i++) {
            // Assume the current element is the minimum
            int minIndex = i;
            // for Finding the smallest element in the remaining array
            for (int j = i + 1; j < arr.length; j++) {
                if (arr[j] < arr[minIndex]) {
                    minIndex = j;
                }
            }

            // Swaping the smallest element with the current element
            int temp = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = temp;
        }

        //Display the sorted array
        System.out.print("\nSorted array: ");
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}

// -------------------------------------------
// output:
// Original array: 64 25 12 22 11
// Sorted array: 11 12 22 25 64 
