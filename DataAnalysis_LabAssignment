Object #1. Read the data from CSV file (Population.csv, Sales.csv) and perform the mathematical operations for example calculate percentage of total population and the name of the country which has the largest population. For Sales.csv file, find out the name of product the which is largest sold with region and amount. Files can be designed and data may be assumed by the user.

PROGRAM:

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.util.*;

public class DataAnalysis {
    public record PopulationRecord(String country, long population) {}
    public record SalesRecord(String product, String region, int unitsSold, double unitPrice, double totalAmount) {}

    public static void main(String[] args) {
        File populationFile = new File("Population.csv");
        File salesFile = new File("Sales.csv");

        processPopulationData(populationFile);
        System.out.println("\n" + "=".repeat(80) + "\n");
        processSalesData(salesFile);
    }

    // --- POPULATION ANALYSIS ---
    public static void processPopulationData(File file) {
        System.out.println(" 1. POPULATION DATA ANALYSIS (" + file.getName() + ")");
        System.out.println("-".repeat(70));

        List<PopulationRecord> records = new ArrayList<>();
        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            br.readLine(); // skip header
            String line;
            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.isEmpty()) continue;
                String[] parts = line.split(",");
                records.add(new PopulationRecord(parts[0].trim(), Long.parseLong(parts[1].trim())));
            }
        } catch (IOException e) {
            System.err.println("Error reading " + file.getName() + ": " + e.getMessage());
            return;
        }

        //Total population & max population
        long totalPopulation = 0;
        PopulationRecord largestCountry = records.get(0);

        for (PopulationRecord record : records) {
            totalPopulation += record.population();
            if (record.population() > largestCountry.population()) {
                largestCountry = record;
            }
        }

        // Display Country Table with % calculation
        System.out.printf("%-5s | %-25s | %18s | %15s%n", "No.", "Country", "Population", "Share (%)");
        System.out.println("-".repeat(70));

        int index = 1;
        for (PopulationRecord record : records) {
            // Formula: (Country Population / Total Population) * 100
            double percentage = ((double) record.population() / totalPopulation) * 100.0;
            System.out.printf("%-5d | %-25s | %,18d | %14.2f%%%n",
                    index++, record.country(), record.population(), percentage);
        }

        System.out.println("-".repeat(70));
        System.out.printf("%-5s | %-25s | %,18d | %14.2f%%%n", "TOTAL", "All Sample Countries", totalPopulation, 100.0);
        System.out.println("-".repeat(70));

        double largestPercentage = ((double) largestCountry.population() / totalPopulation) * 100.0;
        System.out.println("\nPOPULATION SUMMARY");
        System.out.printf("  - Total Combined Population : %,d%n", totalPopulation);
        System.out.printf("  - Country with Largest Pop  : %s%n", largestCountry.country());
        System.out.printf("  - Largest Population Count  : %,d citizens%n", largestCountry.population());
        System.out.printf("  - Percentage of Total World : %.2f%%%n", largestPercentage);
    }

    // --- SALES ANALYSIS ---
    public static void processSalesData(File file) {
        System.out.println(" 2. SALES DATA ANALYSIS (" + file.getName() + ")");
        System.out.println("-".repeat(73));

        List<SalesRecord> salesList = new ArrayList<>();
        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            br.readLine(); // skip header
            String line;
            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.isEmpty()) continue;
                String[] parts = line.split(",");
                salesList.add(new SalesRecord(
                        parts[0].trim(),
                        parts[1].trim(),
                        Integer.parseInt(parts[2].trim()),
                        Double.parseDouble(parts[3].trim()),
                        Double.parseDouble(parts[4].trim())
                ));
            }
        } catch (IOException e) {
            System.err.println("Error reading " + file.getName() + ": " + e.getMessage());
            return;
        }

        // Print Transaction Table
        System.out.printf("%-15s | %-10s | %10s | %12s | %15s%n",
                "Product", "Region", "Units Sold", "Unit Price", "Total Amount ($)");
        System.out.println("-".repeat(73));

        double grandTotalRevenue = 0.0;
        int grandTotalUnits = 0;
        SalesRecord highestSingleSale = salesList.get(0);

        for (SalesRecord s : salesList) {
            grandTotalRevenue += s.totalAmount();
            grandTotalUnits += s.unitsSold();
            System.out.printf("%-15s | %-10s | %,10d | $%,11.2f | $%,14.2f%n",
                    s.product(), s.region(), s.unitsSold(), s.unitPrice(), s.totalAmount());

            if (s.totalAmount() > highestSingleSale.totalAmount()) {
                highestSingleSale = s;
            }
        }

        System.out.println("-".repeat(73));
        System.out.printf("%-15s | %-10s | %,10d | %12s | $%,14.2f%n",
                "TOTAL", "All Regions", grandTotalUnits, "-", grandTotalRevenue);
        System.out.println("-".repeat(73));

        // Group Aggregations by Product
        Map<String, Integer> productUnitsMap = new HashMap<>();
        Map<String, Double> productRevenueMap = new HashMap<>();
        Map<String, List<SalesRecord>> productRegionRecords = new HashMap<>();

        for (SalesRecord s : salesList) {
            productUnitsMap.put(s.product(), productUnitsMap.getOrDefault(s.product(), 0) + s.unitsSold());
            productRevenueMap.put(s.product(), productRevenueMap.getOrDefault(s.product(), 0.0) + s.totalAmount());
            productRegionRecords.computeIfAbsent(s.product(), k -> new ArrayList<>()).add(s);
        }

        // Find top product by revenue
        String topProductByRevenue = Collections.max(
                productRevenueMap.entrySet(), Map.Entry.comparingByValue()).getKey();

        // Find top product by units
        String topProductByUnits = Collections.max(
                productUnitsMap.entrySet(), Map.Entry.comparingByValue()).getKey();

        // Print Insights
        System.out.println("\nSALES SUMMARY & INSIGHTS");

        System.out.println("\n1. LARGEST SOLD PRODUCT BY TOTAL REVENUE (AMOUNT):");
        System.out.printf("   Product Name : %s%n", topProductByRevenue);
        System.out.printf("   Total Revenue: $%,.2f (%d units total)%n",
                productRevenueMap.get(topProductByRevenue), productUnitsMap.get(topProductByRevenue));
        System.out.println("   Breakdown by Region:");
        for (SalesRecord record : productRegionRecords.get(topProductByRevenue)) {
            System.out.printf("     - Region: %-8s | Units: %,4d | Amount: $%,11.2f%n",
                    record.region(), record.unitsSold(), record.totalAmount());
        }

        System.out.println("\n2. LARGEST SOLD PRODUCT BY QUANTITY (UNITS):");
        System.out.printf("   Product Name : %s%n", topProductByUnits);
        System.out.printf("   Total Units  : %,d units (Total Amount: $%,.2f)%n",
                productUnitsMap.get(topProductByUnits), productRevenueMap.get(topProductByUnits));

        System.out.println("\n3. LARGEST INDIVIDUAL SALE TRANSACTION:");
        System.out.printf("   Product Name : %s%n", highestSingleSale.product());
        System.out.printf("   Region       : %s%n", highestSingleSale.region());
        System.out.printf("   Units Sold   : %,d%n", highestSingleSale.unitsSold());
        System.out.printf("   Total Amount : $%,.2f%n", highestSingleSale.totalAmount());
    }
}

